# MANDATORY PRODUCTION ENVIRONMENT VARIABLES
NODE_ENV=development
PORT=5000

# MONGODB CONNECTION STRING
# Cloud Atlas Example: mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/mindora_db?retryWrites=true&w=majority
# Local / Fallback: mongodb://127.0.0.1:27017/mindora_db (If empty, automatically uses MongoMemoryServer for development)
MONGODB_URI=

# JWT SECRET FOR RBAC AUTHENTICATION
JWT_SECRET=mindora_super_secret_jwt_key_exhibition_2026_change_in_prod

# ALLOWED FRONTEND ORIGINS (CORS)
CLIENT_URL=http://localhost:5173

# EVENT TIMEZONE
TZ=Asia/Colombo
